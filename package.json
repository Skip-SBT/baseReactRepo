{
    "name": "project-name",
    "version": "1.0.0",
    "private": true,
    "dependencies": {
        "@emotion/react": "~11.14.0",
        "@emotion/styled": "~11.14.0",
        "@mui/icons-material": "~9.5.0",
        "@mui/material": "~9.5.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5"
    },
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "vite build",
        "preview": "vite preview",
        "check:eslint": "eslint --max-warnings 0 --color src",
        "check:eslint:fix": "eslint --fix --max-warnings 0 --color src",
        "check:stylelint": "stylelint --color --report-needless-disables --report-invalid-scope-disables src/**/*.scss",
        "check:stylelint:fix": "stylelint --fix --color --report-needless-disables --report-invalid-scope-disables src/**/*.scss",
        "check:spellcheck": "cspell --no-progress --color",
        "check:all": "npm run check:eslint && npm run check:stylelint && npm run check:spellcheck",
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "reset": "rimraf dist node_modules && npm install",
        "bump-version": "node bump-version.js"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@cspell/dict-de-ch": "^1.3.3",
        "@cspell/dict-de-de": "^4.1.3",
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "~10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "~19.3.0",
        "@types/react-dom": "~19.3.0",
        "@typescript-eslint/eslint-plugin": "~8.72.1",
        "@typescript-eslint/parser": "~8.72.1",
        "@vitejs/plugin-react": "^6.2.1",
        "cspell": "^10.4.1",
        "eslint": "~10.14.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "postcss-selector-parser": "~7.2.0",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.4",
        "sass": "^1.108.1",
        "stylelint": "^18.0.0",
        "stylelint-config-standard": "^41.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-prettier": "^5.1.0",
        "stylelint-scss": "^7.4.0",
        "typescript": "6.0.3",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "typescript": "6.0.3"
    }
}
